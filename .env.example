# 数据库
DATABASE_URL=sqlite:///./data.db
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://riji:riji_password_change_me@127.0.0.1:3306/riji?charset=utf8mb4

# JWT 认证
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRE_DAYS=7

# MiniMax AI 配置（TokenPlan Plus，一个 key 覆盖所有模态）
LLM_PROVIDER=vivo  # minimax | vivo | ark（切换 chat/stream 主模型）
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M2.7-highspeed
MINIMAX_MOCK=true  # true=返回模拟数据不消耗额度，false=调真实API

# VIVO AI 平台（App 鉴权）
VIVO_APP_ID=your-app-id
VIVO_APP_KEY=your-app-key
VIVO_API_BASE=https://api-ai.vivo.com.cn
VIVO_MODEL=Doubao-Seed-2.0-mini
VIVO_REASONING_EFFORT=minimal
VIVO_ENABLE_THINKING=false
VIVO_TIMEOUT_SEC=60
VIVO_IMAGE_MODEL=Doubao-Seedream-4.5
VIVO_IMAGE_TIMEOUT_SEC=90
VIVO_TTS_ENGINE_ID=short_audio_synthesis_jovi
VIVO_TTS_TIMEOUT_SEC=60
VIVO_ASR_ENGINE_ID=shortasrinput
VIVO_ASR_TIMEOUT_SEC=70
VIVO_ASR_END_VAD_TIME=2000
VIVO_ASR_PUNCTUATION=1
VIVO_ASR_CHINESE2DIGITAL=1
VIVO_ASR_NET_TYPE=1
VIVO_EMBEDDING_BASE_URL=https://api-ai.vivo.com.cn
VIVO_EMBEDDING_MODEL=m3e-base
VIVO_EMBEDDING_QUERY_INSTRUCTION="为这个句子生成表示以用于检索相关文章："
VIVO_VISION_ENABLED=true
VIVO_VISION_MODEL=Doubao-Seed-2.0-mini
VIVO_VISION_PROMPT="请识别并描述这张图片的可见内容，输出一段中文详实介绍。要求包含：主体对象、场景环境、人物动作或状态、关键细节、整体氛围；表述客观连贯，约80-150字，不要编造图片中看不见的信息。"
VIVO_VISION_MAX_IMAGES=10
VIVO_VISION_TIMEOUT_SEC=50
VIVO_VISION_CACHE_TTL_SEC=21600

# 联网搜索
WEB_SEARCH_PROVIDER=exa

# Exa 联网搜索
EXA_API_KEY=your-exa-api-key
EXA_API_BASE=https://api.exa.ai
EXA_SEARCH_ENABLED=true
EXA_SEARCH_TIMEOUT_SEC=30
EXA_SEARCH_NUM_RESULTS=5
EXA_SEARCH_HIGHLIGHTS_MAX_CHARACTERS=1200

# 火山引擎联网搜索（API Key 接入）
VOLC_SEARCH_API_KEY=your-volcengine-search-api-key
VOLC_SEARCH_API_BASE=https://open.feedcoopapi.com/search_api/web_search
VOLC_SEARCH_ENABLED=false
VOLC_SEARCH_TIMEOUT_SEC=30
VOLC_SEARCH_NUM_RESULTS=5
VOLC_SEARCH_TIME_RANGE=OneYear

# 记忆系统
MEMORY_ENABLED=true
MEMORY_VECTOR_ENABLED=true
MEMORY_DIR=./memory_store
MEMORY_EMBEDDING_PROVIDER=vivo  # hash | dashscope | vivo
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_BATCH_SIZE=10
MEMORY_EMBEDDING_TIMEOUT_SEC=30
MEMORY_TOP_K=6
MEMORY_MAX_DISTANCE=0.9
MEMORY_CHUNK_SIZE=800
MEMORY_CHUNK_OVERLAP=100
MEMORY_FAIL_OPEN=true

ATOA_LIVE_CANDIDATES=3
ATOA_AI_MAX_RETRIES=2
ATOA_AI_RETRY_BASE_SEC=1.0
ATOA_WORKER_POLL_SEC=2.0
ATOA_JOB_MAX_ATTEMPTS=3

# 豆包实时语音模型 3.0（全双工）
VOLC_REALTIME_VOICE_ENABLED=false
VOLC_REALTIME_VOICE_API_KEY=your-volcengine-realtime-voice-api-key
VOLC_REALTIME_VOICE_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
VOLC_REALTIME_VOICE_MODEL=1.2.6.1
VOLC_REALTIME_VOICE_DEFAULT_VOICE=zh_female_xiaohe_jupiter_bigtts
REALTIME_VOICE_MAX_GLOBAL_SESSIONS=5
REALTIME_VOICE_MAX_SESSION_SEC=1200
REALTIME_VOICE_IDLE_CLOSE_SEC=540
REALTIME_VOICE_TOOL_TIMEOUT_SEC=8
REALTIME_VOICE_CONFIRM_TTL_SEC=120
REALTIME_VOICE_TICKET_TTL_SEC=60
REALTIME_VOICE_STORE_TRANSCRIPT=true
REALTIME_VOICE_STORE_AUDIO=false
REALTIME_VOICE_MAX_TOOL_RESULT_CHARS=4000
REALTIME_VOICE_MAX_INPUT_FRAMES=100
REALTIME_VOICE_MAX_RECONNECTS=2
REALTIME_VOICE_PROVIDER=volcengine_duplex

# 阿里云百炼 / 通义千问 Embedding
# 启用方式：
# MEMORY_VECTOR_ENABLED=true
# MEMORY_EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# 视觉理解模型（兼容旧配置，建议优先使用 VIVO_VISION_*）
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_DEEPSEEK_V4_FLASH_MODEL=ep-20260603141535-z2l7c
ARK_DEEPSEEK_V4_PRO_MODEL=ep-20260528104127-tn2f7
ARK_DOUBAO_MINI_MODEL=ep-20260607122404-2m67p
ARK_GLM_4_7_MODEL=ep-20260607122957-8jtq2
ARK_TIMEOUT_SEC=90
CHAT_AI_GLOBAL_CONCURRENCY=20
CHAT_AI_FLASH_CONCURRENCY=5
CHAT_AI_DOUBAO_MINI_CONCURRENCY=10
CHAT_AI_GLM_4_7_CONCURRENCY=5
ARK_VISION_MODEL=doubao-seed-2-0-mini-260215
ARK_VISION_ENABLED=true
ARK_VISION_MAX_IMAGES=10
ARK_VISION_TIMEOUT_SEC=50
ARK_VISION_CACHE_TTL_SEC=21600

# 高德地图 Web 服务 API（服务端代理，禁止写入前端）
AMAP_WEB_SERVICE_KEY=your-amap-web-service-key
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SEC=8
AMAP_REVERSE_GEOCODE_MONTHLY_LIMIT=150000
AMAP_IP_LOCATION_MONTHLY_LIMIT=150000
AMAP_WEATHER_MONTHLY_LIMIT=5000
AMAP_LOCATION_CACHE_TTL_SEC=1800

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 服务器
HOST=127.0.0.1
PORT=8000
